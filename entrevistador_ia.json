    {
      "parameters": {
        "functionCode": "if (!$json.output) {\n  throw new Error('No se encontró el contenido de las preguntas del modelo IA.');\n}\n\nconst textoLimpio = $json.output.replace(/\\\\n/g, '\\n');\nconst preguntas = textoLimpio\n  .split('\\n')\n  .map(p => p.trim())\n  .filter(p => p.length > 0);\n\nreturn [{\n  json: {\n    preguntas,\n    preguntaActual: preguntas[0],\n    paso: 1\n  }\n}];"
      },
      "name": "Separar Preguntas2",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        400,
        -528
      ],
      "id": "292c6ef0-5206-4224-89d8-49cde739f008"
    },
    {
      "parameters": {
        "functionCode": "const pregunta = $json.preguntaActual || 'Gracias por su tiempo, fin de la entrevista.';\n\nconst twiml = `<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<Response>\n  <Say language=\"es-ES\" voice=\"female\">${pregunta}</Say>\n  <Record action=\"/twilio-transcribe-callback\" method=\"POST\" maxLength=\"30\" finishOnKey=\"*\" transcribe=\"true\" transcribeCallback=\"/twilio-transcribe-callback\" />\n</Response>`;\n\nreturn {\n  headers: { 'Content-Type': 'text/xml' },\n  body: twiml\n};"
      },
      "name": "Function - Generar TwiML",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
