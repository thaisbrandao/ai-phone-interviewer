    {
      "parameters": {
        "functionCode": "// Aquí recibes la transcripción y avanzas el paso.\n// Ejemplo simple, imprime la transcripción\n\nconst transcription = $json.TranscriptionText || 'No transcription';\n\nconsole.log('Transcription:', transcription);\n\n// Aquí debes guardar el estado, actualizar la siguiente pregunta, etc.\n\nreturn [{ json: { transcription } }];"
